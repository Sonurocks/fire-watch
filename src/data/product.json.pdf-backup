                "url": "https://fire-watch.co/storage/images/ProductFile/ProductFile_6746380841786.pdf"
              }
            ],
            "breadcrumb": [],
            "listingDescription": "FW Heat Detectors monitor temperature by using either a dual-thermistor network or a single thermistor CS versions which provides a voltage output proportional to the external air temperature"
          },
